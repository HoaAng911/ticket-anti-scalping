# frontend/.env — copy thành .env rồi điền giá trị thật

# Backend API (Vite proxy: dùng /api)
VITE_API_BASE_URL=/api

# Mạng geth private-net (mặc định lab)
VITE_NETWORK_NAME=Ticket Private Clique
VITE_CHAIN_ID=12345
VITE_RPC_URL=http://127.0.0.1:8545

# Contract addresses (sau khi deploy)
VITE_TICKET_CONTRACT_ADDRESS=0x...
VITE_MARKETPLACE_CONTRACT_ADDRESS=0x...

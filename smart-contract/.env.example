# smart-contract/.env — copy thành .env rồi điền giá trị thật
# KHÔNG commit file .env vào git

# RPC Sepolia testnet
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Private key ví deploy (ví test, KHÔNG dùng ví thật có tiền)
DEPLOYER_PRIVATE_KEY=0x...

# API key Etherscan để verify source
ETHERSCAN_API_KEY=

# ── Cầu nối cross-chain (buổi 5) ──────────────────────────────────────────
# Địa chỉ ví relayer (Account #1 của hardhat node) — dùng cho script deploy
# và dịch vụ relayer ở backend/. KHÔNG commit khoá riêng thật.
RELAYER_ADDRESS=

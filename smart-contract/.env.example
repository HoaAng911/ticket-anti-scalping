# smart-contract/.env — copy: cp .env.example .env
# Lab chỉ chạy local (geth private-net chainId 12345). KHÔNG commit file .env.

# Private key ví deploy (tuỳ chọn trên lab).
# Lab geth thường unlock deployer trên node1 — để trống là được.
# Chỉ điền khi muốn Hardhat ký bằng key thay vì personal_unlockAccount.
# DEPLOYER_PRIVATE_KEY=0x...

# Ví relayer (tuỳ chọn — bridge hardhat chainA/chainB buổi 5).
# RELAYER_ADDRESS=

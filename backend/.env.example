# backend/.env — copy thành .env rồi điền giá trị thật

# Server
# macOS thường chiếm 5000 (AirPlay) — dùng 5001
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ticket-anti-scalping

# JWT
JWT_SECRET=thay-bang-chuoi-bi-mat-cua-ban
JWT_EXPIRES_IN=7d

# Blockchain — mặc định trỏ geth private-net
NETWORK_NAME=ticket-private-clique
CHAIN_ID=12345
RPC_URL=http://127.0.0.1:8545

# (Tuỳ chọn) Sepolia
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Contract addresses (sau khi deploy: smart-contract/deployments/localhost.json)
TICKET_CONTRACT_ADDRESS=0x...
MARKETPLACE_CONTRACT_ADDRESS=0x...

# Admin faucet / mint — mặc định unlock deployer trên geth
DEPLOYER_ADDRESS=0xdecc0bf86a34de96B161b1F910ce2684d36bb4B4
# GETH_PASSWORD=ticket123
# Hoặc dùng private key thay unlock:
# DEPLOYER_PRIVATE_KEY=0x...

# Frontend origin dùng để cấu hình CORS
CLIENT_ORIGIN=http://localhost:5173
